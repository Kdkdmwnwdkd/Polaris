*.iml
.gradle/
build/
*/build/
# 例外：core/build 是**源码包**（Android 构建引擎），不是 Gradle 产物，必须入库。
# 不加这条的话 git 会一直静默忽略它——2026-10-28 就是这样让远端多出 7 个本地不认识的
# 文件（上一轮走 REST API 推的，绕过了 gitignore）。
!app/src/main/java/com/beichen/polaris/core/build/
# 3.5 拆模块：同一个源码包随 :core 搬到了 core/src/main，上面的例外路径随之失效
# （已经 tracked 的文件不受影响，但**新增**文件会被静默忽略，git add 整目录还会被拒）。
!core/src/main/java/com/beichen/polaris/core/build/
local.properties
.idea/
captures/
.DS_Store
*.apk
!gradle/wrapper/gradle-wrapper.jar

# llama.cpp 源码（MIT）在构建时由 scripts/fetch-llama.sh 拉取固定 tag，不进仓库
app/src/main/cpp/llama.cpp/

# CMake/native 构建中间产物
app/.cxx/

# W-13：内置 Shizuku APK 由 CI 构建时下载，不进仓库
app/src/main/assets/shizuku.apk

# x86_64 容器测试套件（~8MB 的 rootfs + proot），由 scripts/fetch-x86-testkit.sh 拉取，
# 只用于 `-Px86Rootfs=true` 的本地调试包，不进仓库
app/src/debugX86/assets/

# QA 全套 runner 的日志目录（run-all.sh 生成，勿入库）
qa-logs/

# QA 里 fork 子进程 raise(SIGABRT) 会掉 core dump 在仓库根目录，
# 别让它们混进来（名字是 core.<pid>，大小几十 MB）。
core.[0-9]*

# Python 字节码（QA 脚本的 __pycache__，2026-11-07 曾误入库）
__pycache__/
*.pyc

# 签名私钥：任何情况下都不进仓库（历史上有名的坑：debug.keystore 被当发布签名用了）
# CI 从 Actions Secrets 解出，本地放仓库外，口令写 local.properties（同样被忽略）。
*.jks
*.keystore
