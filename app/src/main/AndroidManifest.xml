<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== L0 基础网络 ===== -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- W-52：无线调试端点靠 mDNS 自动发现（配对/连接端口都在广播里）。
         normal 权限，安装即授予、不弹窗；NsdManager 本身用它加入组播组。 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- ===== L2 前台服务 / 截图 / 录音 / 相机 / 语音（截图视觉通道） ===== -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ===== L3 存储（存截图 / 跨 App 读写） ===== -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />

    <!-- ===== L4 系统级特殊授权（均需在设置中手动授予） ===== -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!-- ===== L9 构建链路：拉起系统安装器安装 CI 产出的 APK ===== -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- REQUEST_INSTALL_PACKAGES：W-13 起用于「一键安装内置 Shizuku」（拉起系统安装器，非静默安装）。 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <!-- ===== L5 Shizuku / ADB 提权通道（需先安装 Shizuku 并授权） ===== -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- ===== L6 蓝牙 / 上下文感知 =====
         BLUETOOTH / BLUETOOTH_ADMIN / BLUETOOTH_CONNECT / BLUETOOTH_SCAN：
         代码中未实现任何蓝牙能力，遵循最小权限原则移除；后续实现对应能力时再申请。 -->

    <!-- ===== L7 代理能力（高危，仅自用侧载包可用） =====
         ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION / CALL_PHONE / SEND_SMS / READ_SMS /
         RECEIVE_SMS：代码中均未实现（无拨号、无短信收发、无定位读取），遵循最小权限原则
         移除；后续实现对应能力时再申请，并按危险等级接入 L10 审批闸门。 -->

    <!-- android:name 指向 AgentKitApplication：它只做一件事——在最早时机装上 CrashLogger -->
    <!-- requestLegacyExternalStorage：targetSdk 降到 28 后，Android 10/11 上要显式声明
         才能用旧版共享存储模式（容器 -b /sdcard 与作品库读写依赖它） -->
    <application
        android:name=".AgentKitApplication"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:label="北辰"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.AgentKit">

        <!-- ===== L8 创作工坊：作品库文件分享/播放的 content:// 通道 ===== -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            launchMode="singleTop" 是**必须的**，不是优化。

            定时任务通知的 PendingIntent 带 FLAG_ACTIVITY_NEW_TASK|FLAG_ACTIVITY_CLEAR_TOP。
            在默认的 standard 模式下，CLEAR_TOP 对已存在实例的语义是「销毁 + 重建」：
            点一次通知 → Activity 重建 → ViewModel 重建（实测初始化 1.3~2.6 秒重跑一遍），
            而 onCleared 会取消 viewModelScope —— 正在跑的任务被连带杀掉，用户看到的是
            「点了个通知，任务没了」。

            声明 singleTop 后，同一 task 顶部已有实例时走 onNewIntent（MainActivity 已实现），
            Activity 与 ViewModel 都复用，正在跑的任务不受影响。
            设备实测：修复前每次点通知 ViewModel 初始化计数 +1；修复后不再增长。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 无障碍自动化服务：用户需在系统设置中手动开启，BIND_ACCESSIBILITY_SERVICE 由系统授予 -->
        <service
            android:name=".automation.AgentAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            android:label="北辰 · 自动化">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent_accessibility_config" />
        </service>

        <!-- 通知监听服务（L3 感知层）：系统级服务，需在“通知访问权限”中手动授予 -->
        <service
            android:name=".automation.AgentNotificationListener"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false"
            android:label="北辰 · 通知监听">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- B 批：Agent 长任务前台服务。
             长任务（多步 LLM + 工具调用）期间把进程提到前台，避免被系统回收。
             dataSync 类型对应 FOREGROUND_SERVICE_DATA_SYNC 权限（Manifest 已声明）。
             exported=false：只由本 App 内部启动。 -->
        <service
            android:name=".core.agent.AgentRunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 后台存活自检：没有电脑的用户用它替代 adb dumpsys -->
        <service
            android:name=".core.agent.SurvivalCheckService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 桌面助手（桌宠）：悬浮窗活在 Service 里，没有 Activity。
             必须常驻前台，否则 App 退到后台几分钟就被回收、悬浮窗跟着消失。
             specialUse 是 Android 14 对「不属于其它任何已定义类型」的前台服务的分类；
             targetSdk=28 时系统不会强制校验类型，但声明了才能在未来升级 targetSdk 后继续用。
             exported=false：只由本 App 内部启动（PetState.start / ensureRunning）。 -->
        <service
            android:name=".pet.PetOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的桌面常驻助手悬浮窗，可随时在设置或桌宠菜单里关闭" />
        </service>

        <!-- 快捷设置磁贴：唤醒词的替代入口。
             「不做常驻监听」是有意的（spec §2.1：1–3% 电量/小时，而用量尚无数据），
             但「每次都要回桌面找小球」又太深，所以给一个零成本的一键入口。
             BIND_QUICK_SETTINGS_TILE 由系统授予，用户不授权也只在磁贴里看不到它。
             exported=true 是必需的：绑定方是系统 UI，不是本应用。 -->
        <service
            android:name=".pet.PetTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:label="北辰"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- W-13：Shizuku 提供者（权限/服务发现） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
